#include <winver.h>
#include <winuser.h>

1 ICON "picoamp.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "picoamp.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "JZZY & Claude"
            VALUE "FileDescription",  "PicoAmp for Windows"
            VALUE "FileVersion",      PICOAMP_VERSION
            VALUE "ProductName",      "PicoAmp"
            VALUE "ProductVersion",   PICOAMP_VERSION
            VALUE "LegalCopyright",   "CC BY-NC-SA 4.0"
            VALUE "OriginalFilename", "PicoAmp.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
